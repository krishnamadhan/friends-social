# Copy this file to `.env` and fill in your Supabase credentials
# Do NOT commit the real `.env` file to git. `.gitignore` already excludes it.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-anon-key

# Example:
# VITE_SUPABASE_URL=https://wlnhapuqcusoqvvrzvlc.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...